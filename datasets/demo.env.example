# Template for a dataset. Copy it, fill it in, and it becomes one running
# instance of the app with its own database, port and password:
#
#   cp datasets/demo.env.example datasets/demo.env
#   make up DATASET=demo
#
# Only this example file is committed. Real dataset files are gitignored, so
# nobody's estate, passwords or keys can ride along in a push.

# --- Identity ---------------------------------------------------------------
# DATASET names the instance. It picks the container name, the Compose project
# and the host directory the database lives in (instance/<DATASET>/).
# It must match this file's own name: datasets/<DATASET>.env
DATASET=demo
COMPOSE_PROJECT_NAME=oe-demo

# Shown in the sidebar on every page, so you can always see which estate is on
# screen before you edit anything. Leave blank to hide the badge.
DATASET_LABEL=DEMO DATA

# One port per dataset, so several can run side by side.
PORT=5000

# Set to 1 for any dataset holding real data. ops.ps1 and the Makefile refuse
# to wipe or seed a protected dataset outright - the guard that stops a routine
# demo reset from eating a real estate.
DATASET_PROTECTED=0

# --- Security ---------------------------------------------------------------
# Generate a fresh pair per dataset - never share them between instances:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev_key_change_this_to_random_string
ADMIN_PASSWORD=change_me_immediately

# --- Database ---------------------------------------------------------------
# This is the path INSIDE the container and is the same for every dataset.
# The compose mount above is what points it at this dataset's files.
DATABASE_URL=sqlite:////app/instance/estate.db

# --- Flask ------------------------------------------------------------------
FLASK_ENV=production
