# Template for the site's settings. Copy it, fill it in, and start the stack:
#
#   cp datasets/site.env.example datasets/site.env
#   make up
#
# Only this example file is committed. The real site.env is gitignored, so no
# password or key can ride along in a push. Estates themselves are not set
# here: create them from the dropdown in the sidebar (see datasets/README.md).

# --- Identity ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=open-estate
CONTAINER_NAME=open_estate

# The port the app answers on.
PORT=5000

# Which address that port is published on. The default is loopback: the app is
# reachable from the host itself, and from nothing else, until something in
# front of it (a reverse proxy, an SSH tunnel, a tailnet serve) chooses to
# expose it. Set BIND_ADDR=0.0.0.0 only on a host you have actually firewalled.
BIND_ADDR=127.0.0.1

# Who the container runs as. It must be the owner of this checkout and of
# instance/, because a Linux bind mount keeps the host's ownership and the app
# has to create its own databases inside it. `id -u` and `id -g`.
PUID=1000
PGID=1000

# --- Security ---------------------------------------------------------------
# One login opens every estate on this site. Generate a fresh pair:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev_key_change_this_to_random_string
ADMIN_PASSWORD=change_me_immediately

# --- Flask ------------------------------------------------------------------
FLASK_ENV=production
